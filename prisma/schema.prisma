// 閽㈢绯荤粺鏁版嵁搴?Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum RoleType {
  pm
  planner
  artist
  ui
  server
  client
  devops
  animator
  sound
  tester
}

enum TaskItemType {
  requirement
  task
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskStage {
  filed
  designing
  initial
  preliminary
  final
  finalAcceptance
  completed
}

enum ReferenceType {
  design
  ui
  document
  link
}

enum NotificationType {
  progress_update
  behind_progress
  comment
  reference
  approval_submitted
  approval_approved
  approval_rejected
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// ============ 鐢ㄦ埛 ============
model User {
  id         String   @id @default(uuid())
  employeeId String   @unique @map("employee_id")        // 宸ュ彿
  password   String                                      // bcrypt 鍔犲瘑
  name       String
  phone      String
  email      String
  avatar     String
  role       String                                      // RoleType 鏋氫妇
  isAdmin    Boolean  @default(false) @map("is_admin")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 鍏崇郴
  assignedPhases     TaskPhase[]              @relation("PhaseAssignee")
  comments           Comment[]
  references         Reference[]              @relation("ReferenceAuthor")
  receivedNotifications Notification[]        @relation("NotificationRecipient")
  actedNotifications Notification[]           @relation("NotificationActor")
  taskHistories      TaskHistory[]            @relation("TaskOperator")
  progressHistories  TaskProgressHistory[]    @relation("ProgressOperator")
  phaseAssigneeLogs  TaskProgressHistory[]    @relation("PhaseAssigneeLog")
  sentApprovals      TaskApprovalRequest[]    @relation("ApprovalRequester")
  reviewedApprovals  TaskApprovalRequest[]    @relation("ApprovalReviewer")
  dailyNotes         DailyNote[]              @relation("DailyNoteAuthor")

  @@map("users")
}

// ============ 椤圭洰 ============
model Project {
  id             String   @id @default(uuid())
  name           String
  description    String
  createdAt      DateTime @default(now()) @map("created_at")

  // JSON 瀛樺偍鏁扮粍瀛楁
  nonWorkdays    Json     @map("non_workdays")     // string[]
  extraWorkdays  Json     @map("extra_workdays")    // string[]

  // 鍏崇郴
  phaseTemplates  ProjectPhaseTemplate[]
  plannings       Planning[]
  tasks           Task[]
  approvalRequests TaskApprovalRequest[]
  dailyNotes      DailyNote[]

  @@map("projects")
}

// ============ 椤圭洰闃舵妯℃澘 ============
model ProjectPhaseTemplate {
  id        String   @id @default(uuid())
  name      String
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@map("project_phase_templates")
}

// ============ 瑙勫垝 ============
model Planning {
  id        String    @id @default(uuid())
  name      String
  color     String?
  deadline  DateTime?
  createdAt DateTime  @default(now()) @map("created_at")

  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tasks             Task[]
  approvalRequests  TaskApprovalRequest[]

  @@map("plannings")
}

// ============ 浠诲姟 ============
model Task {
  id                  String    @id @default(uuid())
  itemType            TaskItemType @map("item_type")
  parentRequirementId String?   @map("parent_requirement_id")
  title               String
  description         String    @db.Text
  status              String                              // TaskStatus
  priority            TaskPriority
  dueDate             DateTime? @map("due_date")
  assigneeId          String?   @map("assignee_id")
  stage               String                              // TaskStage (鍏煎鏃у瓧娈?
  currentPhaseId      String?   @map("current_phase_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  planningId String?  @map("planning_id")
  planning   Planning? @relation(fields: [planningId], references: [id], onDelete: SetNull)

  // 鍏崇郴
  phases            TaskPhase[]
  references        Reference[]
  comments          Comment[]
  histories         TaskHistory[]
  progressHistories TaskProgressHistory[]
  notifications     Notification[]

  @@index([projectId])
  @@index([planningId])
  @@index([parentRequirementId])
  @@map("tasks")
}

// ============ 浠诲姟闃舵 ============
model TaskPhase {
  id         String    @id @default(uuid())
  templateId String    @map("template_id")     // 鏉ユ簮妯℃澘 ID
  name       String
  order      Int
  progress   Int       @default(0)             // 0-100
  status     String                            // TaskPhaseStatus
  startTime  DateTime? @map("start_time")
  endTime    DateTime? @map("end_time")

  assigneeId String?   @map("assignee_id")
  assignee   User?     @relation("PhaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  taskId     String    @map("task_id")
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // 鍙嶅悜鍏崇郴
  progressHistories TaskProgressHistory[]
  notifications     Notification[]

  @@index([taskId])
  @@index([assigneeId])
  @@map("task_phases")
}

// ============ 鍙傝€冭祫鏂?============
model Reference {
  id        String   @id @default(uuid())
  type      ReferenceType
  url       String
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  authorId String?  @map("author_id")
  author   User?    @relation("ReferenceAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("references")
}

// ============ Personal notifications ============
model Notification {
  id        String    @id @default(uuid())
  type      NotificationType
  title     String
  body      String    @db.Text
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  recipientId String @map("recipient_id")
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String? @map("actor_id")
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  projectId  String? @map("project_id")
  planningId String? @map("planning_id")
  taskId     String? @map("task_id")
  phaseId    String? @map("phase_id")

  task  Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  phase TaskPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([taskId])
  @@index([phaseId])
  @@map("notifications")
}

// ============ 璇勮 ============
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  authorId String   @map("author_id")
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  taskId   String   @map("task_id")
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

// ============ 浠诲姟鍘嗗彶 ============
model TaskHistory {
  id        String   @id @default(uuid())
  field     String                              // 鍙樻洿瀛楁
  oldValue  String   @map("old_value")
  newValue  String   @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  operatorId String   @map("operator_id")
  operator   User     @relation("TaskOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([operatorId])
  @@map("task_histories")
}

// ============ 杩涘害鍘嗗彶 ============
model TaskProgressHistory {
  id          String   @id @default(uuid())
  phaseName   String   @map("phase_name")
  oldProgress Int      @map("old_progress")
  newProgress Int      @map("new_progress")
  createdAt   DateTime @default(now()) @map("created_at")

  taskId      String    @map("task_id")
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  phaseId     String    @map("phase_id")
  phase       TaskPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  assigneeId  String?   @map("assignee_id")
  assignee    User?     @relation("PhaseAssigneeLog", fields: [assigneeId], references: [id], onDelete: SetNull)

  operatorId  String    @map("operator_id")
  operator    User      @relation("ProgressOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([phaseId])
  @@index([operatorId])
  @@map("task_progress_histories")
}

// ============ 浠诲姟鐢宠瀹℃壒 ============
model TaskApprovalRequest {
  id            String    @id @default(uuid())
  title         String
  remark        String    @db.Text
  phaseSnapshot Json      @map("phase_snapshot")   // [{name, assigneeId}]
  status        ApprovalStatus @default(pending)
  reviewComment String?   @map("review_comment") @db.Text
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projectId           String  @map("project_id")
  project             Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  planningId          String?  @map("planning_id")
  planning            Planning? @relation(fields: [planningId], references: [id], onDelete: SetNull)

  parentRequirementId String?  @map("parent_requirement_id")

  requesterId         String  @map("requester_id")
  requester           User    @relation("ApprovalRequester", fields: [requesterId], references: [id])

  reviewerId          String? @map("reviewer_id")
  reviewer            User?   @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([requesterId])
  @@index([status])
  @@map("task_approval_requests")
}

// ============ 姣忔棩澶囨敞 ============
model DailyNote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  dateKey   String   @map("date_key")                       // "2026-06-24" 鏍煎紡
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberId  String   @map("member_id")
  member    User     @relation("DailyNoteAuthor", fields: [memberId], references: [id], onDelete: Cascade)

  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([memberId, projectId, dateKey])
  @@index([projectId, dateKey])
  @@map("daily_notes")
}

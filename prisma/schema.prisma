generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid())
  employeeId            String                @unique @map("employee_id")
  password              String
  name                  String
  phone                 String
  email                 String
  avatar                String
  role                  String
  isAdmin               Boolean               @default(false) @map("is_admin")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  comments              Comment[]
  dailyNotes            DailyNote[]           @relation("DailyNoteAuthor")
  actedNotifications    Notification[]        @relation("NotificationActor")
  receivedNotifications Notification[]        @relation("NotificationRecipient")
  defaultReviewProjects Project[]             @relation("ProjectDefaultReviewer")
  references            Reference[]           @relation("ReferenceAuthor")
  assignedApprovals     TaskApprovalRequest[] @relation("ApprovalAssignedReviewer")
  sentApprovals         TaskApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals     TaskApprovalRequest[] @relation("ApprovalReviewer")
  taskHistories         TaskHistory[]         @relation("TaskOperator")
  assignedPhases        TaskPhase[]           @relation("PhaseAssignee")
  phaseAssigneeLogs     TaskProgressHistory[] @relation("PhaseAssigneeLog")
  progressHistories     TaskProgressHistory[] @relation("ProgressOperator")
  projectMemberships    ProjectMember[]

  @@map("users")
}

model Project {
  id                String                 @id @default(uuid())
  name              String
  description       String
  createdAt         DateTime               @default(now()) @map("created_at")
  nonWorkdays       Json                   @map("non_workdays")
  extraWorkdays     Json                   @map("extra_workdays")
  defaultReviewerId String?                @map("default_reviewer_id")
  dailyNotes        DailyNote[]
  plannings         Planning[]
  phaseTemplates    ProjectPhaseTemplate[]
  defaultReviewer   User?                  @relation("ProjectDefaultReviewer", fields: [defaultReviewerId], references: [id])
  approvalRequests  TaskApprovalRequest[]
  tasks             Task[]
  members           ProjectMember[]

  @@index([defaultReviewerId], map: "projects_default_reviewer_id_fkey")
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectPhaseTemplate {
  id        String   @id @default(uuid())
  name      String
  order     Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@map("project_phase_templates")
}

model Planning {
  id               String                @id @default(uuid())
  name             String
  deadline         DateTime?
  createdAt        DateTime              @default(now()) @map("created_at")
  projectId        String                @map("project_id")
  color            String?
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvalRequests TaskApprovalRequest[]
  tasks            Task[]

  @@index([projectId], map: "plannings_project_id_fkey")
  @@map("plannings")
}

model Task {
  id                  String                @id @default(uuid())
  itemType            TaskItemType          @map("item_type")
  parentRequirementId String?               @map("parent_requirement_id")
  title               String
  description         String                @db.Text
  status              String
  priority            TaskPriority
  dueDate             DateTime?             @map("due_date")
  assigneeId          String?               @map("assignee_id")
  stage               String
  currentPhaseId      String?               @map("current_phase_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  projectId           String                @map("project_id")
  planningId          String?               @map("planning_id")
  comments            Comment[]
  notifications       Notification[]
  references          Reference[]
  histories           TaskHistory[]
  phases              TaskPhase[]
  progressHistories   TaskProgressHistory[]
  planning            Planning?             @relation(fields: [planningId], references: [id])
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([planningId])
  @@index([parentRequirementId])
  @@map("tasks")
}

model TaskPhase {
  id                String                @id @default(uuid())
  templateId        String                @map("template_id")
  name              String
  order             Int
  progress          Int                   @default(0)
  status            String
  startTime         DateTime?             @map("start_time")
  endTime           DateTime?             @map("end_time")
  assigneeId        String?               @map("assignee_id")
  taskId            String                @map("task_id")
  notifications     Notification[]
  assignee          User?                 @relation("PhaseAssignee", fields: [assigneeId], references: [id])
  task              Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  progressHistories TaskProgressHistory[]

  @@index([taskId])
  @@index([assigneeId])
  @@map("task_phases")
}

model Reference {
  id        String        @id @default(uuid())
  type      ReferenceType
  url       String
  title     String
  taskId    String        @map("task_id")
  authorId  String?       @map("author_id")
  createdAt DateTime      @default(now()) @map("created_at")
  author    User?         @relation("ReferenceAuthor", fields: [authorId], references: [id])
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([taskId], map: "references_task_id_fkey")
  @@map("references")
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  title       String
  body        String           @db.Text
  dedupeKey   String?          @unique @map("dedupe_key")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  recipientId String           @map("recipient_id")
  actorId     String?          @map("actor_id")
  projectId   String?          @map("project_id")
  planningId  String?          @map("planning_id")
  taskId      String?          @map("task_id")
  phaseId     String?          @map("phase_id")
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id])
  phase       TaskPhase?       @relation(fields: [phaseId], references: [id])
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([taskId])
  @@index([phaseId])
  @@index([actorId], map: "notifications_actor_id_fkey")
  @@map("notifications")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  authorId  String   @map("author_id")
  taskId    String   @map("task_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model TaskHistory {
  id         String   @id @default(uuid())
  field      String
  oldValue   String   @map("old_value")
  newValue   String   @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")
  taskId     String   @map("task_id")
  operatorId String   @map("operator_id")
  operator   User     @relation("TaskOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([operatorId])
  @@map("task_histories")
}

model TaskProgressHistory {
  id          String    @id @default(uuid())
  phaseName   String    @map("phase_name")
  oldProgress Int       @map("old_progress")
  newProgress Int       @map("new_progress")
  createdAt   DateTime  @default(now()) @map("created_at")
  taskId      String    @map("task_id")
  phaseId     String    @map("phase_id")
  assigneeId  String?   @map("assignee_id")
  operatorId  String    @map("operator_id")
  assignee    User?     @relation("PhaseAssigneeLog", fields: [assigneeId], references: [id])
  operator    User      @relation("ProgressOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  phase       TaskPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([phaseId])
  @@index([operatorId])
  @@index([assigneeId], map: "task_progress_histories_assignee_id_fkey")
  @@map("task_progress_histories")
}

model TaskApprovalRequest {
  id                  String         @id @default(uuid())
  title               String
  remark              String         @db.Text
  phaseSnapshot       Json           @map("phase_snapshot")
  status              ApprovalStatus @default(pending)
  reviewComment       String?        @map("review_comment") @db.Text
  reviewedAt          DateTime?      @map("reviewed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  projectId           String         @map("project_id")
  requesterId         String         @map("requester_id")
  reviewerId          String?        @map("reviewer_id")
  parentRequirementId String?        @map("parent_requirement_id")
  planningId          String?        @map("planning_id")
  assignedReviewerId  String?        @map("assigned_reviewer_id")
  assignedReviewer    User?          @relation("ApprovalAssignedReviewer", fields: [assignedReviewerId], references: [id])
  planning            Planning?      @relation(fields: [planningId], references: [id])
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester           User           @relation("ApprovalRequester", fields: [requesterId], references: [id])
  reviewer            User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([projectId])
  @@index([requesterId])
  @@index([assignedReviewerId])
  @@index([status])
  @@index([planningId], map: "task_approval_requests_planning_id_fkey")
  @@index([reviewerId], map: "task_approval_requests_reviewer_id_fkey")
  @@map("task_approval_requests")
}

model DailyNote {
  id        String   @id @default(uuid())
  content   String   @db.Text
  dateKey   String   @map("date_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberId  String   @map("member_id")
  projectId String   @map("project_id")
  member    User     @relation("DailyNoteAuthor", fields: [memberId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([memberId, projectId, dateKey])
  @@index([projectId, dateKey])
  @@map("daily_notes")
}

enum TaskItemType {
  requirement
  task
}

enum TaskPriority {
  low
  medium
  high
}

enum ReferenceType {
  design
  ui
  document
  link
}

enum NotificationType {
  progress_update
  behind_progress
  comment
  reference
  approval_submitted
  approval_approved
  approval_rejected
  approval_cancelled
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}
